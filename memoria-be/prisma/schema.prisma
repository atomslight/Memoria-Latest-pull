generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String?
  bio           String?   @db.VarChar(150)
  profilePicUrl String?   @map("profile_pic_url")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  photos              Photo[]
  createdCircles      Circle[]       @relation("CircleCreator")
  circleMemberships   CircleMember[]
  circlePhotoUploads  CirclePhoto[]
  conversations       Conversation[]

  @@map("users")
}

model Photo {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  hash            String    @unique
  storagePath     String    @map("storage_path")
  fileSize        Int       @map("file_size")
  mimeType        String    @map("mime_type")
  width           Int?
  height          Int?
  capturedAt      DateTime? @map("captured_at")
  deletedAt       DateTime? @map("deleted_at")
  mood            String?
  cluster         String?
  locationName    String?   @map("location_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Visual embeddings (pgvector) - Phase 2
  embedding       Unsupported("vector(1408)")?
  embeddingStatus String?   @default("pending") @map("embedding_status")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiResult     AIResult?
  circlePhotos CirclePhoto[]

  @@index([userId, capturedAt])
  @@index([userId, deletedAt])
  @@index([hash])
  @@map("photos")
}

model AIResult {
  id                String   @id @default(uuid())
  photoId           String   @unique @map("photo_id")
  caption           String?
  mood              String?
  locationName    String?   @map("location_name")
  latitude          Float?   @map("latitude")
  longitude         Float?   @map("longitude")
  timesVisitedLocation Int?      @map("times_visited_location")
  isItFrequent      Boolean?  @map("is_it_frequent")
  usageLimitBlocked Boolean?  @map("usage_limit_blocked")

  captionConfidence Float?   @map("caption_confidence")
  faces             Json?
  metadata          Json?
  processingStatus  String   @default("pending") @map("processing_status")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([processingStatus])
  @@map("ai_results")
}

model Circle {
  id          String         @id @default(uuid())
  name        String
  description String?
  emoji       String?        @default("🔵")
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  creator  User           @relation("CircleCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members  CircleMember[]
  photos   CirclePhoto[]

  @@index([createdBy])
  @@map("circles")
}

model CircleMember {
  id       String   @id @default(uuid())
  circleId String   @map("circle_id")
  userId   String   @map("user_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@index([circleId])
  @@map("circle_members")
}

model CirclePhoto {
  id         String   @id @default(uuid())
  circleId   String   @map("circle_id")
  photoId    String   @map("photo_id")
  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  circle   Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  photo    Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@unique([circleId, photoId])
  @@index([circleId, uploadedAt])
  @@map("circle_photos")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String    @default("New Conversation")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  parts          Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

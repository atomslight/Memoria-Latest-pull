# Memoria AI inference service — copy to .env and fill values

NODE_ENV=development
AI_SERVICE_PORT=8080

# Must match main API `AI_INTERNAL_SECRET`
AI_INTERNAL_SECRET=development-only-change-me

# Main Memoria API (tool calls from chat + message persistence)
# Local default; for NODE_ENV=production|staging set MAIN_API_URL explicitly to your deployed API base URL.
MAIN_API_URL=http://127.0.0.1:3000

VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
# VERTEX_AI_SERVICE_ACCOUNT_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_API_KEY=
OPENAI_API_KEY=

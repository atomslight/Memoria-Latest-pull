# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/memoria

# JWT — either (A) access+refresh pair, or (B) legacy single secret
# (A) Recommended: access + refresh (POST /api/v1/auth/refresh)
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_IN_HRS=720
JWT_ACCESS_TOKEN_ISSUER=memoria-access
JWT_REFRESH_TOKEN_ISSUER=memoria-refresh
# (B) Legacy: single secret (access token only, min 32 characters)
# JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# JWT_EXPIRES_IN=7d

# AWS S3
S3_REGION=ap-south-1
# Public bucket (avatars); also used when CDN_URL is set for avatar URLs
S3_BUCKET_NAME=wisetalk-dev
# Private bucket (memories / user photos)
S3_PRIVATE_BUCKET_NAME=wisetalk-dev-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: fall back if S3_* keys are not set
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: CloudFront base URL (no trailing slash) — avatars use this when set
# CDN_URL=https://xxxx.cloudfront.net

# Optional
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
S3_PRESIGN_DEFAULT_SECONDS=3600

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_SERVICE_ACCOUNT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

OPENAI_API_KEY=
MOBILE_APP_URL=http://localhost:8081

# Microservices — main API → AI inference (embeddings, captions, chat stream proxy)
# Local default below; for NODE_ENV=production|staging set AI_SERVICE_URL explicitly (e.g. internal load balancer URL).
# Must match ai-service `AI_INTERNAL_SECRET` and the URL/port where ai-service listens (`AI_SERVICE_PORT`, default 8080).
AI_SERVICE_URL=http://127.0.0.1:8080
AI_INTERNAL_SECRET=development-only-change-me

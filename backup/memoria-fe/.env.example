# API Configuration
# Default in code is https://memoria.slashifytech.in.
# Production/staging: set explicitly if needed:
# EXPO_PUBLIC_API_URL=https://memoria.slashifytech.in
#
# Local API: you MUST set EXPO_PUBLIC_USE_LOCAL_API=true, otherwise localhost/10.0.2.2 in env is ignored
# (avoids Metro/shell injecting localhost and breaking devices).
# EXPO_PUBLIC_USE_LOCAL_API=true
# Optional LAN URL for a physical device: EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Supabase — registration fallback only (when POST /api/v1/auth/signup is missing). Login uses the Memoria API.
# The hostname must resolve in a browser or sign-up fallback will fail.
